# Ollama Cloud API nøgle (skift til din egen - HARDCOD DEN ALDRIG I KODEN)
OLLAMA_API_KEY=sk-din-hemmelige-nøgle-her

# Valgfrit: URL til Ollama Cloud endpoint
# OLLAMA_URL=https://ollama.com/v1/chat/completions

# Valgfrit: MAX POWER indstillinger
# MAX_WORKERS=8
# REQUEST_TIMEOUT=90
# MAX_RETRIES=2
# RETRY_DELAY=1.5
# DEFAULT_ROUNDS=5

# Valgfrit: Rate limit (requests per second) - juster op/ned efter API-plan
# RATE_LIMIT_QPS=5.0

# Valgfrit: Streaming output (true/false). Bemærk: parallelle kald kan blive rodede.
# STREAMING=false

# Valgfrit: Circuit breaker threshold + fallback model
# CIRCUIT_THRESHOLD=3
# FALLBACK_MODEL=glm-5.1:cloud

# Valgfrit: Webhook URL — får besked når debat/batch er færdig
# WEBHOOK_URL=https://dinside.dk/evoswarm

# Valgfrit: Foruddefineret emne til batch-kørsel
# DEBATE_TOPIC=Hvordan bør vi forholde os til sikkerhed i AI-systemer?

# Valgfrit: Batch mode - flere emner adskilt med | eller ny linje
# DEBATE_TOPICS=AI etik | Fremtidens arbejdsmarked | Cybertrusler i 2030

# Valgfrit: Tilpas agenter via JSON. Hvis tom, bruges default swarm.
# EVOSWARM_AGENTS=[{"name":"Nova","role":"Futurist","belief":"AI vil overgå os inden 2030.","model":"glm-5.1:cloud"}]
