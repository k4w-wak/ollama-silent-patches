    for pattern, name in auth_patterns:
        out = _run_cli(f"cd {repo_dir} && grep -rn --include='*.py' --include='*.go' --include='*.js' --include='*.ts' '{pattern}' 2>/dev/null | head -10", 30)
        if out and "[INGEN OUTPUT]" not in out:
