            repo_dir = os.path.join(tmpdir, dirs[0])
    
    results.append(f"✅ Cloned to {repo_dir}\n")
    
    # 1. Hardcoded secrets scan
    results.append("🔴 1. HARDCODED SECRETS SCAN")
